// nextflow.config -- Module_1 (nucleotide -> peptide translation)
manifest {
    name            = 'Module_1'
    description      = 'Rules-based nucleotide->peptide translation with origin-aware framing'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}
process {
    executor      = 'local'
    errorStrategy = 'terminate'
    withName: 'TRANSLATE'         { cpus = 2; memory = '4 GB' }
    withName: 'FASTQ2FASTA_META'  { cpus = 1; memory = '4 GB' }
    withName: 'VARIANT_EXTRACT'   { cpus = 1; memory = '8 GB' }   // reference index in memory
    withName: 'ALIGN_EXTRACT'     { cpus = 8; memory = '32 GB' }  // aligner (scaffold)
    withName: 'VARIANT_READAWARE' { cpus = 8; memory = '32 GB' }  // aligner + isovar (scaffold)
}
profiles {
    standard { process.executor = 'local' }
    test     { process.resourceLimits = [ cpus: 2, memory: '4 GB', time: '30m' ] }
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'YOUR-JOB-QUEUE'
        aws.region        = 'eu-west-2'
        workDir           = 's3://YOUR-BUCKET/nf-work'
    }
    // envs: TRANSLATE/FASTQ2FASTA/VARIANT_EXTRACT -> biopython, pandas;
    //       ALIGN_EXTRACT -> STAR/bwa-mem2 + samtools;  VARIANT_READAWARE -> aligner + isovar.
    conda { conda.enabled = true }
}
