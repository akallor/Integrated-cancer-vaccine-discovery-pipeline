// nextflow.config — Module_2 (MS/MS validation)

manifest {
    name            = 'Module_2'
    description      = 'MS/MS validation: PRIDE -> mzML -> Sage -> MS2Rescore -> group FDR'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}

// bin/ is auto-added to PATH by Nextflow; make sure the scripts there are chmod +x.

process {
    executor      = 'local'
    errorStrategy = 'terminate'

    withName: 'DOWNLOAD_PRIDE' { cpus = 2; memory = '4 GB'  }
    withName: 'CONVERT_STREAM' { cpus = 2; memory = '6 GB'  }   // GC caps set inside the script
    withName: 'BUILD_FASTA'    { cpus = 2; memory = '8 GB'  }
    withName: 'SAGE'           { cpus = 8; memory = '32 GB' }
    withName: 'MS2RESCORE'     { cpus = 4; memory = '16 GB' }
    withName: 'GROUP_FDR'      { cpus = 2; memory = '8 GB'  }
}

// Show the live process table alongside the stage bars.
// (Per-file detail from each script lands in work/<hash>/.command.log — tail -f to watch.)

profiles {

    standard { process.executor = 'local' }

    // Small-runner / CI profile: caps requested resources to the shared runner.
    test {
        process.resourceLimits = [ cpus: 2, memory: '4 GB', time: '30m' ]
    }


    // Example AWS Batch profile — fill in your queue/bucket. Note: passing the
    // mzML S3 *prefix* (not the files) between processes keeps Batch staging cheap;
    // SAGE and MS2RESCORE each aws-s3-sync the spectra they need.
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'YOUR-JOB-QUEUE'
        aws.region       = 'eu-west-2'
        aws.batch.cliPath = '/usr/local/bin/aws'
        workDir          = 's3://YOUR-BUCKET/nf-work'
    }

    // Optional: pin tool environments. Each process needs the binaries its script calls:
    //   DOWNLOAD_PRIDE -> pridepy, awscli
    //   CONVERT_STREAM -> ThermoRawFileParser, awscli
    //   BUILD_FASTA    -> python3 + pandas + pyyaml   (+ common/sequtils.py)
    //   SAGE           -> sage, awscli, python3
    //   MS2RESCORE     -> ms2rescore, awscli
    //   GROUP_FDR      -> python3 + pandas + pyyaml
    conda {
        conda.enabled = true
        // process.conda = "${projectDir}/assets/env.yml"   // supply your env
    }
}
