// nextflow.config — Module_3 (binding affinity / presentation)

manifest {
    name            = 'Module_3'
    description      = 'Binding affinity/presentation: MHCflurry / MHCnuggets + SHAP explain + diagnostic plots'
    version         = '0.2.0'
    nextflowVersion = '>=24.04.0'
}

process {
    executor      = 'local'
    errorStrategy = 'terminate'

    withName: 'PREDICT_MHCFLURRY'     { cpus = 4; memory = '16 GB' }
    withName: 'PREDICT_MHCNUGGETS_I'  { cpus = 4; memory = '16 GB' }
    withName: 'PREDICT_MHCNUGGETS_II' { cpus = 4; memory = '16 GB' }
    withName: 'EXPLAIN'               { cpus = 4; memory = '16 GB' }   // SHAP can be heavy
    withName: 'COMBINE_PREDICTIONS'   { cpus = 1; memory = '2 GB'  }
    withName: 'AGGREGATE'             { cpus = 1; memory = '4 GB'  }
    withName: 'PLOT_JACCARD'          { cpus = 1; memory = '4 GB'  }
    withName: 'PLOT_STATIC'           { cpus = 1; memory = '4 GB'  }
}

profiles {
    standard { process.executor = 'local' }
    test     { process.resourceLimits = [ cpus: 2, memory: '4 GB', time: '30m' ] }
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'YOUR-JOB-QUEUE'
        aws.region        = 'eu-west-2'
        aws.batch.cliPath = '/usr/local/bin/aws'
        workDir           = 's3://YOUR-BUCKET/nf-work'
    }
    // Tool envs per process: predictors -> mhcflurry OR mhcnuggets (+ mod3_common.py);
    // EXPLAIN -> shap (+ mhcflurry if backend=mhcflurry) + optional logomaker;
    // PLOT_* / AGGREGATE -> matplotlib + pandas.
    conda { conda.enabled = true /* process.conda = "${projectDir}/assets/env.yml" */ }
}
